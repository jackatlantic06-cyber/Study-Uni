{
  "crons": [
    {
      "path": "/api/weekly-email",
      "schedule": "0 9 * * 1"
    }
  ],
  "redirects": [
    { "source": "/t/:key([0-9]{2}w[0-9]{2}t[0-9]{1,3})", "destination": "/?utm_source=tiktok&utm_medium=social&utm_content=:key", "permanent": false },
    { "source": "/t/:key([0-9]{2}w[0-9]{2}i[0-9]{1,3})", "destination": "/?utm_source=instagram&utm_medium=social&utm_content=:key", "permanent": false },
    { "source": "/t/:key", "destination": "/?utm_medium=social&utm_content=:key", "permanent": false }
  ],
  "rewrites": [
    { "source": "/marketing", "destination": "/marketing.html" }
  ],
  "headers": [
    {
      "source": "/marketing(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
